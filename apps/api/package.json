{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main",
    "build": "nest build && mkdir -p dist/generated && cp -R src/generated/prisma dist/generated/prisma",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../../prisma/schema.prisma --name init",
    "prisma:seed": "tsx ../../prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@game-platform/contracts": "workspace:*",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/swagger": "^11.1.11",
    "@prisma/client": "^6.6.0",
    "bullmq": "^5.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.0.1",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.3.0",
    "pino": "^9.0.0",
    "prisma": "^6.6.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.1.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/testing": "^11.1.11",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/uuid": "^9.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.0",
    "@vitest/ui": "^3.2.0",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.0"
  }
}
